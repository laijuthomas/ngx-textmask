{
  "name": "angular-ngx-textmask",
  "version": "1.6.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build-prod:lib": "ng build ngx-textmask --configuration production",
    "release": "standard-version",
    "publish:lib": "npm run copy:readme && npm run copy:changelog && npm run copy:license && npm publish ./dist/ngx-textmask",
    "copy:readme": "cpx README.md dist/ngx-textmask",
    "copy:changelog": "cpx CHANGELOG.md dist/ngx-textmask",
    "copy:license": "cpx LICENSE dist/ngx-textmask",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.2.3",
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/platform-browser-dynamic": "^22.2.3",
    "@angular/router": "^22.2.3",
    "bootstrap": "^4.6.1",
    "rxjs": "~7.8.0",
    "standard-version": "^9.5.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-eslint/builder": "22.6.0",
    "@angular-eslint/eslint-plugin": "22.6.0",
    "@angular-eslint/eslint-plugin-template": "22.6.0",
    "@angular-eslint/schematics": "22.6.0",
    "@angular-eslint/template-parser": "22.6.0",
    "@angular/build": "^22.2.3",
    "@angular/cli": "~22.2.3",
    "@angular/compiler-cli": "^22.2.3",
    "@commitlint/cli": "^12.1.4",
    "@commitlint/config-conventional": "^12.1.4",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "coveralls": "^3.1.0",
    "cpx": "^1.5.0",
    "eslint": "^10.13.0",
    "istanbul-lib-instrument": "^6.0.3",
    "ng-packagr": "^22.2.4",
    "typescript": "~6.0.3"
  }
}